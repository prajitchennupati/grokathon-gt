# xAI API (OpenAI-compatible). Leave XAI_API_KEY empty to run purely on cache/canned fallbacks.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4
# Hard timeout for every LLM call, in seconds
LLM_TIMEOUT_S=8
# Force cached / canned LLM responses only (same as --offline)
CLEARANCE_OFFLINE=0

# Shared secret Grok Bots send in the X-Clearance-Token header
CLEARANCE_TOKEN=change-me
# Public URL Grok Bots use to reach this app (e.g. a cloudflared/ngrok tunnel to :8000)
PUBLIC_BASE_URL=http://localhost:8000

# Scenario + demo behaviour
SCENARIO=atl_arrivals_demo.json
DEMO_MODE=0
